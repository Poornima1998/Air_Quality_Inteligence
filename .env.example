# Optional generative-model handover-note feature (does not change numeric predictions)
OPENAI_API_KEY=your-openai-api-key-here(cannot add the API key for git committe)
GENAI_MODEL=gpt-4.1-mini

# Optional: set current provider pricing to estimate per-call cost (USD per 1 million tokens)
GENAI_INPUT_USD_PER_1M=0.40
GENAI_OUTPUT_USD_PER_1M=1.60
